# Build context filter for deploy/docker/php.Dockerfile.
#
# The Docker build context is the REPOSITORY ROOT (`context: ..` in
# deploy/docker-compose.yml), so the image gets the application but none of the
# machine-local state. Two of these entries are load-bearing:
#
#   * `.env` / `deploy/.env` -- the deployment secrets live there; a build context
#     is not a secret store.
#   * `storage` -- this checkout's storage/installed marker would be copied into a
#     fresh image and convince the entrypoint that a brand-new database was
#     already installed.
#
# Matching note: like .gitignore only in spirit, a pattern WITHOUT a slash matches
# at the context root only (verified with docker build), so `vendor` does not also
# match `packages/x/vendor`, and nested files need their own patterns.

# --- VCS and agent tooling ---------------------------------------------------
.git
.github
.gitignore
.gitattributes
.beads
.agents
.ai
.claude
.codex
.cursor
.kilocode
.idea
.vscode
.vagrant
.editorconfig
.styleci.yml

# --- Secrets -----------------------------------------------------------------
.env
.env.*
deploy/.env
!deploy/.env.deploy.example

# --- Installed dependencies and build scratch --------------------------------
vendor
node_modules
package-lock.json
.phpunit.cache
.phpunit.result.cache
.php_cs.cache
playwright-report
test-results
blob-report
playwright
storage

# --- Not needed at run time --------------------------------------------------
# The deploy runner, the compose file it drives, the second-instance provisioner
# and their documentation. All of them sit inside the build context because they
# describe and operate this stack on the HOST, but nothing in the image reads
# them: `COPY . .` in php.Dockerfile would copy them in, and no runtime code
# opens a compose file, a runner or a provision script. Excluding them is what
# lets deploy/deploy.sh skip a rebuild for an ops-only commit instead of
# re-running composer install for the same bytes -- it keeps its
# NON_IMAGE_GLOBS list in step with this section, so add a path to BOTH lists or
# to neither (see "Rebuilding: only when it can possibly matter" in
# deploy/README.md). The markdown changelog and documentation follow the same
# rule.
#
# deploy/docker/* must NOT be added here: php.Dockerfile copies php.ini,
# php-fpm.conf and entrypoint.sh into the image, and docker-compose.yml
# bind-mounts nginx.conf into the `web` container.
deploy/README.md
deploy/deploy.sh
deploy/docker-compose.yml
deploy/provision-instance.sh
CHANGELOG.md
tests
bin
brand
docs
ignorables
data
docker-compose-collection
*.hot

# --- Runtime state (the storage/ exclusion above already covers logs and
#     framework caches; these are the paths a dev machine also leaves behind) --
bootstrap/cache/packages.php
bootstrap/cache/services.php
bootstrap/cache/config.php
bootstrap/cache/routes-*.php
