APP_NAME='Sijilna'
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Supported: mysql, mariadb
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel-crm
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail.
#
# Brevo over the SMTP relay, because that is what the Sijilna deployment sends through. Any SMTP
# provider works: change MAIL_HOST/MAIL_PORT/MAIL_ENCRYPTION and the two credentials.
#
# MAIL_USERNAME and MAIL_PASSWORD are empty on purpose — this file is committed, so no credential
# may live here. Put both in your own `.env`:
#   MAIL_USERNAME  the SMTP login from Brevo -> SMTP & API -> SMTP: your Brevo account email, or
#                  the `xxxxxxxx@smtp-brevo.com` login shown next to the key.
#   MAIL_PASSWORD  the *SMTP key* from that same screen, not your account password. Brevo shows
#                  it once; it looks like a long token, `xsmtpsib-` followed by about 60 chars.
#
# A placeholder here fails at runtime, quietly, and that is the point of this comment:
#
#   * Empty credentials do not stop the application. The CRM boots and renders normally, Brevo
#     answers the SMTP login with `535 Authentication failed`, and only mail is broken. That is
#     deliberately not a boot failure (a CRM that will not start because mail is unset is worse),
#     so it is logged at error level instead of vanishing — see
#     app/Providers/MailDeliveryServiceProvider.php.
#   * MAIL_MAILER=log is the truly silent case: that driver cannot fail, so each message is
#     written to storage/logs/laravel.log, the send reports success, and nothing is delivered.
#     This file used to point at a `mailhog` container that is never created, and the workflow
#     paths swallowed the connection error, so mail disappeared with no log line at all.
#
# Only a real send proves mail works:
#
#     make mail-test MAIL_TO=you@example.com
#
# It prints the SMTP conversation (credentials stripped) and exits non-zero when the server
# refuses. Run it after changing any MAIL_* value, and before trusting a password reset.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
# Keep MAIL_FROM_ADDRESS on the domain your provider has verified, and the same domain as
# MAIL_DOMAIN: that domain is what SPF, DKIM and DMARC are published for, and a mismatch is how
# a working transport still lands in spam.
MAIL_FROM_ADDRESS=support@mohamedlabs.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=mohamedlabs.com

MAIL_RECEIVER_DRIVER=sendgrid
MAIL_RECEIVER_INBOUND_TOKEN=

IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=your_username
IMAP_PASSWORD=your_password

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
