# Sijilna CRM -- production environment template.
#
# Copy to .env next to the checkout root, fill in the empty values, and point
# deploy/.env at the same file (see deploy/README.md):
#
#     cp deploy/.env.deploy.example .env
#     ln -s ../.env deploy/.env
#
# This file is committed, so it must never carry a real secret: every password
# below is empty on purpose. Keys are the ones this application actually reads
# (config/*.php and packages/*/*/config), not a generic Laravel dump -- note
# `CACHE_DRIVER`, which is the key config/cache.php reads; CACHE_STORE is a
# newer Laravel name this fork does not use.

APP_NAME='Sijilna'
APP_ENV=production
# Generate this before the first boot; the container refuses to start without it
# and cannot write it, because .env is mounted read-only.
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.mohamedlabs.com

# Behind the Cloudflare Tunnel the browser talks HTTPS to the edge but nginx
# receives plain HTTP, so Laravel would generate http:// URLs and the browser
# would block them as mixed content. This flag makes
# App\Providers\BrandingServiceProvider force the https scheme. Leave it unset
# (or false) for local development.
APP_FORCE_HTTPS=true

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# DB_HOST is the compose service name, not 127.0.0.1: the application runs in a
# container, not on the host. DB_DATABASE / DB_USERNAME / DB_PASSWORD are also
# what the `db` service and its healthcheck are created from, and
# DB_ROOT_PASSWORD is consumed by MySQL's first initialisation only.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sijilna
DB_USERNAME=sijilna
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
# config/cache.php reads CACHE_DRIVER (not CACHE_STORE). file, because this stack
# runs no Redis or Memcached container.
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Per-instance cookie name, so two Sijilna instances on one host never share a
# session namespace (browsers scope cookies by host, not by port).
SESSION_COOKIE=sijilna_session

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outgoing mail.
#
# Brevo over the SMTP relay, because that is what the Sijilna deployment sends through; any
# SMTP provider works, change the three host keys. IMAP stays a placeholder until an instance
# actually reads a mailbox.
#
# This file is committed, so MAIL_USERNAME and MAIL_PASSWORD are empty on purpose. Fill both in
# .env (the file this template is copied to), never here:
#   MAIL_USERNAME  the SMTP login from Brevo -> SMTP & API -> SMTP: your Brevo account email, or
#                  the `xxxxxxxx@smtp-brevo.com` login shown next to the key.
#   MAIL_PASSWORD  the *SMTP key* from that screen, not the account password. Brevo shows it
#                  once; it looks like a long token, `xsmtpsib-` followed by about 60 characters.
#                  One key per instance, revoked in Brevo when the instance is retired.
#
# Why the earlier values here were the bug rather than an unfinished placeholder:
#
#   * MAIL_MAILER=log cannot fail. Every notification, password reset and workflow email was
#     written to storage/logs/laravel.log, each send reported success, and nothing was delivered —
#     a deployment that looked healthy and sent no mail at all. The application now logs this at
#     critical level on every boot of a production instance, and `make mail-test` refuses it.
#   * MAIL_FROM_ADDRESS=no-reply@example.invalid was a domain nobody owns, so even a working
#     transport would have been rejected or spam-filed by the recipient.
#   * An empty MAIL_USERNAME/MAIL_PASSWORD is not silent but it is not obvious either: the CRM
#     boots and renders, Brevo answers the SMTP login with `535 Authentication failed`, and only
#     mail is broken. That failure is now logged at error level rather than swallowed.
#
# Prove real delivery before trusting a password reset:
#
#     sudo docker compose -f deploy/docker-compose.yml exec app \
#       env MAIL_TO=you@example.com php scripts/mail-test.php
#
# It sends through this configuration, prints the SMTP conversation with the credentials
# stripped, and exits non-zero when the server refuses the message.
#
# The From address must be a sender your provider has verified, and its domain is what SPF, DKIM
# and DMARC are configured for — see "Mail: sending as a real domain" in deploy/README.md.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@mohamedlabs.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=mohamedlabs.com

MAIL_RECEIVER_DRIVER=sendgrid
MAIL_RECEIVER_INBOUND_TOKEN=

IMAP_HOST=imap.example.invalid
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30

# Real-time broadcasting is off in this stack: no Reverb container is deployed,
# so these stay empty and the app falls back to polling notifications.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# First boot only: the entrypoint creates the administrator via
# scripts/create-admin.php when BOTH of these are set. They are read by the
# container, never by the application. Delete both lines after the first
# successful boot (or leave them empty) so the credentials do not sit in a file
# the container keeps reading.
KRAYIN_ADMIN_EMAIL=
KRAYIN_ADMIN_PASSWORD=
# KRAYIN_ADMIN_NAME='Mohamed Ashraf'
