# Sijilna CRM -- production environment template.
#
# Copy to .env next to the checkout root, fill in the empty values, and point
# deploy/.env at the same file (see deploy/README.md):
#
#     cp deploy/.env.deploy.example .env
#     ln -s ../.env deploy/.env
#
# This file is committed, so it must never carry a real secret: every password
# below is empty on purpose. Keys are the ones this application actually reads
# (config/*.php and packages/*/*/config), not a generic Laravel dump -- note
# `CACHE_DRIVER`, which is the key config/cache.php reads; CACHE_STORE is a
# newer Laravel name this fork does not use.

APP_NAME='Sijilna'
APP_ENV=production
# Generate this before the first boot; the container refuses to start without it
# and cannot write it, because .env is mounted read-only.
APP_KEY=
APP_DEBUG=false
APP_URL=https://crm.mohamedlabs.com

# Behind the Cloudflare Tunnel the browser talks HTTPS to the edge but nginx
# receives plain HTTP, so Laravel would generate http:// URLs and the browser
# would block them as mixed content. This flag makes
# App\Providers\BrandingServiceProvider force the https scheme. Leave it unset
# (or false) for local development.
APP_FORCE_HTTPS=true

APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_CURRENCY=USD

VITE_HOST=
VITE_PORT=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# DB_HOST is the compose service name, not 127.0.0.1: the application runs in a
# container, not on the host. DB_DATABASE / DB_USERNAME / DB_PASSWORD are also
# what the `db` service and its healthcheck are created from, and
# DB_ROOT_PASSWORD is consumed by MySQL's first initialisation only.
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=sijilna
DB_USERNAME=sijilna
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=

BROADCAST_DRIVER=log
# config/cache.php reads CACHE_DRIVER (not CACHE_STORE). file, because this stack
# runs no Redis or Memcached container.
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Per-instance cookie name, so two Sijilna instances on one host never share a
# session namespace (browsers scope cookies by host, not by port).
SESSION_COOKIE=sijilna_session

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail and IMAP are placeholders: this demo instance sends nothing and reads no
# mailbox. Fill them in only when the instance is actually handed to a client.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@example.invalid
MAIL_FROM_NAME="${APP_NAME}"
MAIL_DOMAIN=example.invalid

MAIL_RECEIVER_DRIVER=sendgrid
MAIL_RECEIVER_INBOUND_TOKEN=

IMAP_HOST=imap.example.invalid
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=true
IMAP_USERNAME=
IMAP_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

NOTIFICATION_DRIVER=polling
NOTIFICATION_POLL_INTERVAL=30

# Real-time broadcasting is off in this stack: no Reverb container is deployed,
# so these stay empty and the app falls back to polling notifications.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# First boot only: the entrypoint creates the administrator via
# scripts/create-admin.php when BOTH of these are set. They are read by the
# container, never by the application. Delete both lines after the first
# successful boot (or leave them empty) so the credentials do not sit in a file
# the container keeps reading.
KRAYIN_ADMIN_EMAIL=
KRAYIN_ADMIN_PASSWORD=
# KRAYIN_ADMIN_NAME='Mohamed Ashraf'
